# 의존성
node_modules/

# 빌드 산출물 (Electron Forge)
out/
.vite/
dist/

# 아이콘 중간 산출물 (npm run icon 으로 재생성된다)
# icon.ico / icon.png 은 빌드에 필요하므로 커밋한다
assets/icons/build/

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 캐시 / 환경
*.tsbuildinfo
.eslintcache
.env
.env.*

# 런타임 사용자 데이터 (앱이 만드는 설정/임포트 결과)
userdata/

# ⚠️ 앱 설정 파일 — **절대 커밋하지 않는다** (Codex 리뷰 2026-08-18 지적)
#   1. 사용자명·로컬 프로그램 절대 경로가 그대로 들어 있다
#   2. `imported: true` 가 박혀 있어, 새 checkout 이 이걸 읽으면 **자기 시작 메뉴를 스캔하지 않는다**
#   개발 모드의 configDir() 이 프로젝트 루트를 쓰기 때문에 여기 생긴다
blueming-menu.config.json
blueming-menu.config.backup.json

# ⚠️ Rust 빌드 산출물 — 약 257MB. 머신·툴체인 종속이라 커밋 대상이 아니다
#   필요한 바이너리(.dll / .exe)는 빌드 단계에서 만든다
native/**/target/
# 셸 확장 패키지 조립 결과 (build-and-register.ps1 이 매번 새로 만든다)
native/shell-ext/dist/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 에디터 — IDE 자동생성분이 커밋에 섞이는 걸 막는다
# settings.json 은 개인 IDE 설정이라 공유하지 않는다.
# launch.json(디버그 구성)만 나중에 팀 공유용으로 열어둔다.
.vscode/*
!.vscode/launch.json
.vscode/bookmarks.json
.idea/

# Claude Code 로컬 전용 설정 (머신마다 다름)
.claude/settings.local.json
