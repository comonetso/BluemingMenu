<?xml version="1.0" encoding="utf-8"?>
<!--
  Blueming Menu 셸 확장 — Sparse MSIX 패키지.

  ## 왜 MSIX 가 필요한가
  Windows 11 의 1급 컨텍스트 메뉴는 **패키지 identity 를 가진 앱**만 넣을 수 있다.
  일반 레지스트리 COM 등록으로는 "추가 옵션 표시" 하위에만 나온다.
  반디집·PowerToys·VS Code 전부 이 방식이다 (실측: 셋 다 MSIX 로 등록돼 있다).

  ## Sparse 란
  실제 실행 파일은 패키지 **바깥**(우리 앱 폴더)에 두고, 매니페스트만 등록하는 방식이다.
  `AllowExternalContent` 가 그것을 허용하고, 등록할 때 `-ExternalLocation` 으로 실제 위치를 준다.
  Electron 앱 전체를 MSIX 로 다시 포장할 필요가 없다.

  ## 서명
  개발자 모드가 켜져 있으면 `Add-AppxPackage -Register` 로 **서명 없이** 등록된다.
  이 PC 는 이미 `AllowDevelopmentWithoutDevLicense = 1` 이다 (실측).
  배포본을 만들 때는 자체 서명 인증서 + 신뢰 저장소 설치가 필요하다.

  ⚠️ `Clsid` 는 `src/lib.rs` 의 `CLSID_BLUEMING_COMMAND` 와 **반드시** 같아야 한다.
     한쪽만 바꾸면 탐색기가 핸들러를 못 찾아 메뉴가 조용히 사라진다.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 com desktop4 desktop5 rescap">

  <Identity
    Name="BluemingMenu.ShellExt"
    Publisher="CN=Blueming"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Blueming Menu Shell Extension</DisplayName>
    <PublisherDisplayName>Blueming</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Sparse 패키지의 핵심. 실제 파일이 패키지 바깥에 있어도 된다고 선언한다. -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <!--
    `uap10:RuntimeBehavior="win32App"` 를 쓰려면 이 선언이 반드시 있어야 한다.
    없으면 등록 시 0x80080204 로 거부된다 (실측).

    ⚠️ `runFullTrust` 는 restricted capability 다. Microsoft Store 에 올리려면 심사가 필요하지만,
       로컬 등록(`Add-AppxPackage -Register`)과 자체 서명 배포에는 제약이 없다.
       이 앱은 Store 배포 계획이 없다.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!--
      셸 확장만 제공하므로 실행할 앱이 없다. 그래도 MSIX 는 Application 요소를 하나 요구한다.
      `TrustLevel=mediumIL` + `RuntimeBehavior=win32App` 으로 일반 데스크톱 앱처럼 동작시킨다.
    -->
    <Application
      Id="BluemingShellExt"
      Executable="BluemingMenu.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">

      <uap:VisualElements
        DisplayName="Blueming Menu"
        Description="Blueming Menu 탐색기 컨텍스트 메뉴"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- COM 서버 등록. Path 는 ExternalLocation 기준 상대 경로다. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Blueming Menu Shell Extension">
              <com:Class
                Id="7f3a9c21-4e6b-4d8a-9f12-5c8e7a2b6d40"
                Path="blueming_shell_ext.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!--
          1급 컨텍스트 메뉴 등록.
          대상은 `.lnk` 뿐이다 (사용자 지정). 확장자를 늘리려면 ItemType 을 추가한다.
        -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".lnk">
              <desktop5:Verb
                Id="BluemingToggle"
                Clsid="7f3a9c21-4e6b-4d8a-9f12-5c8e7a2b6d40" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
